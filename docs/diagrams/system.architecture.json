  "cards": [
    {
      "dot": "cyan",
      "title": "Entry points",
      "items": [
        "Browser UI reads only via hooks in lib/queries.ts",
        "MCP tools shared by HTTP and stdio transports",
        "/api/v1 is the only bearer-gated, shape-locked surface"
      ]
    },
    {
      "dot": "rose",
      "title": "Upstream protection",
      "items": [
        "One MatchSyncProbe per 60s cycle gates every refresh",
        "Per-isolate semaphore, Redis-shared backoff, SSI_UPSTREAM_PAUSED kill switch",
        "SSI_API_KEY and JWT never reach client code"
      ]
    },
    {
      "dot": "emerald",
      "title": "State",
      "items": [
        "Redis: match cache with smart TTL tiers",
        "AppDatabase: shooter index, achievements, last-known-good match data",
        "Telemetry never logs IPs, user agents, or shooter IDs"
      ]
    }
  ]
